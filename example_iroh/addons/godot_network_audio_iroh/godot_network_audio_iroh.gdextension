[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 =     "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.so"
linux.release.x86_64 =   "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.so"
windows.debug.x86_64 =   "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.dll"
windows.release.x86_64 = "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.dll"
macos.debug =            "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.dylib"
macos.release =          "res://addons/godot_network_audio_iroh/bin/godot_network_audio_iroh_gdext.dylib"
